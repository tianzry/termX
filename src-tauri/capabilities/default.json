{
  "identifier": "default",
  "description": "Default capabilities for termX",
  "windows": ["main", "termx-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-set-always-on-top",
    "opener:default",
    "dialog:default",
    "fs:default",
    "fs:allow-write-text-file",
    "deep-link:default"
  ]
}
